include "std/img"
include "std/io"
include "std/sys"
include "std/list"
include "std/arr"
include "std/regx"
include "std/math"
include "std/frag"
include "std/win"
include "std/vec"
include "std/time"
include "std/drw"

resolution := {512,512}
frag.init(win.init(...resolution,win.CONTEXT_3D));
tex_col := frag.texture(...resolution);
tex_sdf := frag.texture(...resolution);
pg := drw.create_graphics(...resolution);

func update_source(t:f32){
  pg.begin();
  drw.background(0);
  drw.no_stroke();
  drw.fill(1,0,1);
  drw.rect(100,100,100,100);
  drw.fill(1,1,1);
  drw.ellipse(300,300,150,150);
  drw.stroke(1,1,0);
  drw.stroke_weight(3);
  drw.line(300,200,500,0);
  drw.no_stroke();
  drw.fill(0,1,1);
  a := t * 0.001;
  drw.ellipse(300 + math.cos(a) * 200, 200 + math.sin(a) * 200, 50,50);
  pg.end();

  src := pg.read_pixels();
  gray := img.convert[u8,3,u8,2](src,img.COLOR_RGB_GRAY);
  img.threshold(gray, 64, img.THRESH_BINARY);
  ero := img.morphology(gray, 2, img.MORPH_ERODE|img.NORM_L2);
  dt := img.dist_transform(ero, img.NORM_L2);
  n := dt.shape()[0]*dt.shape()[1];
  for (i := 0; i < n; i++){
    dt[i]=math.min(dt[i]*0.01,1.0);
  }
  tex_col.write_pixels(src);
  img.convert(dt,img.COLOR_COPY,src);
  tex_sdf.write_pixels(src);
}


func trace(
  tex_col:frag.Texture, tex_sdf:frag.Texture, 
  o:vec[f32,2], d:vec[f32,2]
):vec[f32,3]{
  t := 0.0;
  for (i := 0; i < 20; i++){
    if (t > 2.0) break;
    p := o + d * t;
    sd := tex_sdf.sample(p).g * 0.1;
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) sd = 9999.0;
    if (sd < 0.001){
      return tex_col.sample(p).rgb;
    }
    t += sd;
  }
  return {0.0,0.0,0.0};
}

shader := frag.program(embed (func(
  @builtin frag_coord:vec[f32,4],
  @varying uv:vec[f32,2],
  @uniform tex_col:frag.Texture,
  @uniform tex_sdf:frag.Texture,
  @uniform resolution:vec[f32,2],
  @uniform t:f32
):vec[f32,4]{
  // return tex_sdf.sample(uv);
  sum := {0.0, 0.0, 0.0};
  for (i := 0; i < 12; i++){
    r := (math.sin((uv + {i,0.0}).dot({12.9898,78.233}))*43758.5453123) % 1.0;
    a := math.PI * 2.0 * (i as f32 + r) / (12.0);
    c := trace(tex_col, tex_sdf, uv, {math.cos(a),math.sin(a)});
    sum += c;
  }
  sum /= 12.0;
  color := {1.0,1.0,1.0} * sum * 1.5;
  return {color.r,color.g,color.b,1.0};
}) as "fragment");


while (1){
  time.fps(120);

  update_source(time.millis() as f32);

  frag.begin(shader);
  frag.uniform("tex_col", tex_col);
  frag.uniform("tex_sdf", tex_sdf);
  frag.uniform("resolution", resolution as vec[f32,2]);
  frag.render();
  frag.end();
  
  e := win.poll();

}